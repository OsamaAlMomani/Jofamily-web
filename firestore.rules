rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // TEST MODE: Allow all read/write for testing
    // In production, uncomment the rules below and comment out the test rules
    match /{document=**} {
      allow read, write: if true;
    }
    
